.footer(v-if='props.props')
  .footer__bg
    .footer__container
      .footer__social-icons
        a.footer__phone-icon(:href='props.props.acf.footer.phone_link')
          Icon(name='Phone')
        a.footer__email-icon(:href='props.props.acf.footer.email_link')
          Icon(name='Email')
        a.footer__facebook-icon(:href='props.props.acf.footer.facebook_link', target='_blank')
          Icon(name='Facebook')
        a.footer__instagram-icon(:href='props.props.acf.footer.instagram_link', target='_blank')
          Icon(name='Instagram')
      router-link.footer__logo(to='/')
        Icon(name='FooterLogo')
      .footer__information
        a.footer__address(v-html='props.props.acf.footer.address', :href='props.props.acf.footer.map_link')
        a.footer__phone-number(v-html='props.props.acf.footer.phone_number', :href='props.props.acf.footer.phone_link')
  .footer__bottom-bg
    .footer__bottom-container
      a.footer__copyright(href='https://www.roostergrin.com/') Online Advantage by Rooster Grin
          
