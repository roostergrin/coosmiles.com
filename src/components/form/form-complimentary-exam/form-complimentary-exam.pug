.form-complimentary-exam
  .form-complimentary-exam__body
    .form-complimentary-exam__success-message(v-if='formSubmitted')
      h2 Thanks for submitting our form!
    form.form-complimentary-exam__form(v-if='!formSubmitted', action='https://coosmiles.com/thank-you' novalidate='novalidate' class='wpcf7-form' method='post')
      div(style='display: none')
          input(type='hidden' name='_wpcf7' value='684')
          input(type='hidden' name='_wpcf7_version' value='5.6')
          input(type='hidden' name='_wpcf7_locale' value='en_US')
          input(type='hidden' name='_wpcf7_unit_tag' value='wpcf7-f684-o1')
          input(type='hidden' name='_wpcf7_container_post' value='0')
      .form-complimentary-exam__group
        textarea.form-complimentary-exam__textarea(name='message', v-model='message', v-validate="'required|alpha'", :class="{ 'form-home__input--error': errors.has('message') }", type='text', placeholder='How can we help you or your loved ones smile brighter?', rows='6')
      .form-complimentary-exam__group.form-complimentary-exam__grouprow
        input.form-complimentary-exam__input(name='fullname', v-model='fullname', v-validate="'required|alpha'", :class="{ 'form-home__input--error': errors.has('fullname') }", type='text', placeholder='First Name')
        input.form-complimentary-exam__input(name='LastName', v-model='LastName', v-validate="'required|alpha'", :class="{ 'form-home__input--error': errors.has('LastName') }", type='text', placeholder='Last Name')        
      .form-complimentary-exam__group
        input.form-complimentary-exam__input(name='phone', v-model='phone', v-validate='{required: true, regex: /^[2-9]\\d{2}-\\d{3}-\\d{4}$/}', :class="{ 'input': true, 'form-home__input--error': errors.has('phone') }", type='phone', placeholder='Phone Number')
      .form-complimentary-exam__group
        input.form-complimentary-exam__input(name='email', v-model='email', v-validate="'required|email'", :class="{ 'input': true, 'form-home__input--error': errors.has('email') }", placeholder='Email Address')
      .form-complimentary-exam__group
        .form-complimentary-exam__label Date of Birth of Patient
        input.form-complimentary-exam__input(name='dob', v-model='dob', v-validate="'required|alpha'", :class="{ 'form-contact__input--error': errors.has('dob') }", type='date')        
      input.form-complimentary-exam__submit-button(type='submit')
