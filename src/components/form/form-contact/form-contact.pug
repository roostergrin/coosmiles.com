.form-contact
  .form-contact__body
    .form-contact__success-message(v-if='formSubmitted')
      h2 Thanks for submitting our form!
    form.form-contact__form(v-if='!formSubmitted', action='https://coosmiles.com/thank-you#wpcf7-f270-o1' novalidate='novalidate' class='wpcf7-form' method='post')
      div(style='display: none')
          input(type='hidden' name='_wpcf7' value='270')
          input(type='hidden' name='_wpcf7_version' value='5.0.1')
          input(type='hidden' name='_wpcf7_locale' value='en_US')
          input(type='hidden' name='_wpcf7_unit_tag' value='wpcf7-f270-o1')
          input(type='hidden' name='_wpcf7_container_post' value='0')
      .form-contact__group
        textarea.form-contact__textarea(name='message', v-model='message', v-validate="'required|alpha'", :class="{ 'form-contact__input--error': errors.has('message') }", type='text', placeholder='Ask any questions and share you concerns.', rows='7')
      .form-contact__group
        input.form-contact__input(name='fullname', v-model='fullname', v-validate="'required|alpha'", :class="{ 'form-contact__input--error': errors.has('name') }", type='text', placeholder='First and Last Name')
      .form-contact__group
        input.form-contact__input(name='email', v-model='email', v-validate="'required|email'", :class="{ 'input': true, 'form-contact__input--error': errors.has('email') }", placeholder='Email Address')
      .form-contact__group
        input.form-contact__input(name='phone', v-model='phone', v-validate='{required: true, regex: /^[2-9]\\d{2}-\\d{3}-\\d{4}$/}', :class="{ 'input': true, 'form-contact__input--error': errors.has('phone') }", type='phone', placeholder='Phone Number')
      .form-contact__submit-button-container
        input.form-contact__submit-button(type='submit' value='Send')
