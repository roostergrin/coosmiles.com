.hero-home
  .hero-home__desktop
    swiper.hero-home__slider(:options='swiperOption')
      swiperSlide.hero-home__slide
        .hero-home__image(style='background-image: url(static/hero-home.jpg)')
      swiperSlide.hero-home__slide
        .hero-home__image(style='background-image: url(static/hero-home2.jpg)')
      swiperSlide.hero-home__slide
        .hero-home__image(style='background-image: url(static/hero-home3.jpg)')
  .hero-home__mobile
    .hero-home__slider
      .hero-home__image(style='background-image: url(static/hero-home.jpg)')
  .hero-home__container
    .hero-home__waypoint(v-waypoint='{ active: true, callback: scrolled}')
    .hero-home__title(:class='{ "hero-home__title--active": fadeTitle}', v-waypoint="{ active: true, callback: onWaypointTitle, options: intersectionTitleOptions }")
      | Smile Bright, Shine Brighter
      br
      | HOW WOULD A NEW SMILE CHANGE YOUR LIFE?
    a.hero-home__button(@click='showComplimentaryModal = true')
      | BEGIN YOUR SMILE JOURNEY HERE

  transition(name='fade-in-modal')
    ComplimentaryExamForm(v-show='showComplimentaryModal', @closeComplimentaryModal='showComplimentaryModal = false')

