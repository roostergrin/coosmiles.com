.custom-home-reviews
  .custom-home-reviews__container
    .custom-home-reviews__title(v-html='props.title', :class='{ "custom-home-reviews__title--active": fadeTitle}', v-waypoint="{ active: true, callback: onWaypointTitle, options: intersectionTitleOptions }")
  swiper.custom-home-reviews__slider(:options='swiperOption')
    swiperSlide.custom-home-reviews__slide(v-for='(slide, i) in props.slides', :key='i')
      .custom-home-reviews__image(:style='"background-image: url(" + slide.image + ");"')
        .custom-home-reviews__testimonial(:class='{ "custom-home-reviews__testimonial--active": swiping}')
          .custom-home-reviews__testimonial--text(v-html='slide.testimonial')
          .custom-home-reviews__testimonial--author(v-html='slide.author')
    .custom-home-reviews__prev-arrow(slot='button-prev', :class='{ "custom-home-reviews__prev-arrow--active": swiping }')
      Icon(name='Arrow')
    .custom-home-reviews__next-arrow(slot='button-next', :class='{ "custom-home-reviews__next-arrow--active": swiping }')
      Icon(name='Arrow')
