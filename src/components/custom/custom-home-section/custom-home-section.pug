.custom-home-section
  .custom-home-section__container
    .custom-home-section__title(v-html='props.title')
    .custom-home-section__body
      .custom-home-section__content(v-html='props.content')
      .custom-home-section__cta(v-html='props.cta')
    .custom-home-section__video
      .custom-home-section__overlay
        img.custom-home-section__image(:src='props.image', @click='showModal = true')
  
  transition(name='fade-in-modal')             
    HomeVideoModal(:props='props', @closeHomeVideoModal='showModal = false', v-show='showModal')
        
