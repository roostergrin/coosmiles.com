.custom-before-after
  .custom-before-after__bg
    .custom-before-after__container 
      .custom-before-after__title(v-html='props.title')
      .custom-before-after__gallery-container
        .custom-before-after__patient(v-for='patient in props.patient')
          .custom-before-after__patient--name(v-html='patient.name')
          .custom-before-after__col-left
            image-compare.custom-before-after__front-teeth(:before='patient.left_after_image', :after='patient.left_before_image')
              Icon(name='LeftArrow', aria-hidden='true', slot='icon-left')
              Icon(name='RightArrow', aria-hidden='true', slot='icon-right')
          .custom-before-after__col-right
            image-compare.custom-before-after__side-teeth(:before='patient.right_after_image', :after='patient.right_before_image')
              Icon(name='LeftArrow', aria-hidden='true', slot='icon-left')
              Icon(name='RightArrow', aria-hidden='true', slot='icon-right')
          
