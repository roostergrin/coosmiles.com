.custom-contact-columns(v-if='props')
  .custom-contact-columns__bg
    .custom-contact-columns__container
      .custom-contact-columns__title(v-html='props.title')
      .custom-contact-columns__row
        .custom-contact-columns__col-left
          .custom-contact-columns__phone
            .custom-contact-columns__phone--icon
              Icon(name='Phone')
            .custom-contact-columns__phone--number(v-html='props.phone_number')
          .custom-contact-columns__email
            .custom-contact-columns__email--icon
              Icon(name='Email')
            .custom-contact-columns__email--address(v-html='props.email')
          .custom-contact-columns__hours
            .custom-contact-columns__hours--icon
              Icon(name='Clock')
            .custom-contact-columns__hours--hours(v-html='props.hours')
            
        .custom-contact-columns__col-center
          .custom-contact-columns__location
            .custom-contact-columns__location--icon
              Icon(name='Pin')
            .custom-contact-columns__location--address(v-html='props.address')
          .custom-contact-columns__map
            iframe(:src='props.map_embed_link', width='300', height='300')
              
              
        .custom-contact-columns__col-right
          ContactForm
