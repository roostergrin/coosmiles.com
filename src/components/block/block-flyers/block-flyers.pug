.block-flyers
  .block-flyers__seperator(:class='{ "block-flyers__seperator--active": fadeLine}', v-waypoint="{ active: true, callback: onWaypointLine, options: intersectionLineOptions }")
    .block-flyers__orange-line
  .block-flyers__bg
    .block-flyers__container    
      h2.block-flyers__title(v-html='props.title', :class='{ "block-flyers__title--active": fadeTitle}', v-waypoint="{ active: true, callback: onWaypointTitle, options: intersectionTitleOptions }")
    .block-flyers__container2
      .block-flyers__content
        .block-flyers__contentlistouter
          article.block-flyers__contentlist(v-if='props.flyer_list' v-for='(program, i) in props.flyer_list', :key='i')
            img.block-flyers__image(:src='program.img', :alt='program.image_alt || program.program_title')
            .block-flyers__copy
              h3.block-flyers__program-title(v-html='program.program_title')
              .block-flyers__program-content(v-html='program.content')
