nav.navigation(:class="{'navigation--scrolled': $store.state.nav || menu}")
  .navigation__container.navigation__desktop
    .navigation__icon(@click='resetNavBg()')
      router-link(to='/')
        Icon(name='logo-coo')

    .navigation__icon.navigation__icon--option(@click='resetNavBg()')
      router-link(to='/')
        Icon(name='logo-coo-options')

    .navigation__links
      span.navigation__link(v-for='nav in props', v-if='nav.navigation', @click='resetNavBg()')
        router-link(:to='nav.path')
          a {{ nav.name }}
  //-     span.navigation__link.navigation__button(@click='showComplimentaryModal = true')
  //-       | Complimentary Exam

  //- transition(name='fade-in-modal')
  //-   ComplimentaryExamModal(v-show='showComplimentaryModal', @closeComplimentaryModal='showComplimentaryModal = false')

  .navigation__container.navigation__mobile
    .navigation__icon(@click='menu = false')
      router-link(to='/')
        Icon(name='logo-coo')

    .navigation__icon.navigation__icon--option(@click='menu = false')
      router-link(to='/')
        Icon(name='logo-coo-options')

    .navigation__menu(@click='menu ? menu = false : menu = true') MENU

  .navigation__container.navigation__mobile.navigation__links--mobile(v-if='menu')
    .navigation__link.navigation__link--mobile(v-for='nav in props', v-if='nav.navigation', @click='menu = false')
      router-link(:to='nav.path') {{ nav.name }}

    .navigation__link.navigation__link--mobile.navigation__button(@click='showComplimentaryModal = true, menu = false')
      | Complimentary Exam
